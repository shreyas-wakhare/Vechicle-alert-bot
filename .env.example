# ─── EMAIL SETTINGS ───────────────────────────────────────────────────────────
# Supported providers: gmail | outlook | yahoo | custom
EMAIL_PROVIDER=gmail

# Your email address (the one receiving alerts)
EMAIL_USER=you@gmail.com

# App Password (NOT your normal login password — see SETUP.md for how to get it)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Only process emails from this sender (your tracking system's email address)
ALERT_SENDER=alerts@yourtrackingsystem.com

# IMAP settings are auto-filled for gmail/outlook/yahoo.
# Only fill these if EMAIL_PROVIDER=custom
IMAP_HOST=
IMAP_PORT=993

# How often to check for missed emails as a fallback (seconds). Default: 60
EMAIL_POLL_INTERVAL=60

# ─── WHATSAPP SETTINGS ────────────────────────────────────────────────────────
# The exact name of the WhatsApp group to send alerts to
# (must match exactly, including spaces and emojis)
WHATSAPP_GROUP_NAME=Fleet Alerts 🚗

# ─── ALERT SETTINGS ───────────────────────────────────────────────────────────
# Comma-separated list of alert types to IGNORE (leave blank to forward all)
# Example: IGNORED_ALERTS=Ignition On,Ignition Off
IGNORED_ALERTS=

# Minimum severity level to forward: LOW | MEDIUM | HIGH | CRITICAL
MIN_SEVERITY=LOW

# ─── SECOND EMAIL SOURCE (track9999) ─────────────────────────────────────────
# The email address that sends track9999 alerts (default: noreply@track9999.com)
ALERT_SENDER_2=noreply@track9999.com

# ─── ADMIN & CRITICAL CONTACTS ───────────────────────────────────────────────
# WhatsApp number of the admin who can control the bot via personal DMs
# Format: country code + number, no + sign (e.g. 971527456266)
ADMIN_NUMBER=971527456266

# Comma-separated numbers to DM for 3+ red severity alerts
CRITICAL_CONTACTS=971565227135,971564002750
